# --- Pesos de modelo --------------------------------------------------------
# Nunca versionar. O modelo é distribuído pela nuvem com checksum e rollback
# (ADR-006); um .pt no git seria uma segunda fonte da verdade.
*.pt
*.onnx
*.engine
*.weights
models/

# --- Mídia ------------------------------------------------------------------
# Clipe de evento é dado pessoal (R-9). Não entra no repositório em hipótese
# alguma, nem como fixture.
clips/
*.mp4
*.mkv
*.ts

# --- Prisma -----------------------------------------------------------------
prisma/*.db
prisma/*.db-journal

