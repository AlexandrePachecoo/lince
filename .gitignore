# --- Node -------------------------------------------------------------------
node_modules/
dist/
build/
.turbo/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*

# --- Python (apps/agent) ----------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Segredos ---------------------------------------------------------------
.env
.env.*
!.env.example

# --- Pesos de modelo --------------------------------------------------------
# Nunca versionar. O modelo é distribuído pela nuvem com checksum e rollback
# (ADR-006); um .pt no git seria uma segunda fonte da verdade.
*.pt
*.onnx
*.engine
*.weights
models/

# --- Mídia ------------------------------------------------------------------
# Clipe de evento é dado pessoal (R-9). Não entra no repositório em hipótese
# alguma, nem como fixture. `.ts` NÃO entra aqui: colide com o TypeScript de
# apps/api e apps/dashboard, e o agente não produz segmento MPEG-TS (os clipes
# saem em fMP4 -- init.mp4 + frag_NNNNN.mp4 --, já cobertos por *.mp4).
clips/
*.mp4
*.mkv

# --- Prisma -----------------------------------------------------------------
prisma/*.db
prisma/*.db-journal

# --- Editor / SO ------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
