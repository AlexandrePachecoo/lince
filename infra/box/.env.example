# Configuração DO BOX — o que é da máquina, não da loja (§5.2). Câmeras, zonas e
# limiares descem da nuvem; nada disso entra aqui.
#
#   cp .env.example .env && chmod 600 .env
#
# O .env real tem a credencial do agente e nunca vai para o git.

# Versão da imagem do agente. Fixa, nunca `latest`: cada loja roda o que está escrito
# aqui, e atualizar é trocar este número e rodar `docker compose up -d` (docs/box.md).
# As versões publicadas são as tags `agente-vX.Y.Z` do repositório, sem o prefixo.
LINCE_VERSAO=0.1.0

# Control plane. Em produção, HTTPS.
LINCE_API_URL=https://api.exemplo.com.br

# Credencial do agente desta loja (§5.1). A nuvem guarda só o hash; este é o único
# lugar onde o token existe em claro.
LINCE_AGENT_TOKEN=troque-pelo-token-do-agente

# Pasta do host com o modelo, e o nome do arquivo dentro dela. Montada só leitura.
# Padrão: ./modelos ao lado deste arquivo.
# LINCE_MODELOS_DIR=./modelos
# LINCE_MODELO=yolox_s.onnx

# Só para imagem construída localmente ou registry próprio:
# LINCE_IMAGEM=ghcr.io/alexandrepachecoo/lince-agent
