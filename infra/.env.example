# Copie para infra/.env e troque a senha. O .env real nunca entra no git.
#
#   cp infra/.env.example infra/.env

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=lince
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=lince
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379

# --- Câmeras RTSP sintéticas (docker-compose.rtsp.yml) -----------------------
# Só usado em desenvolvimento; não existe na loja.
RTSP_PORT=8554

# --- URLs consumidas pela API (Prisma, BullMQ) ------------------------------
# Mantenha usuário/senha/porta em sincronia com as variáveis acima.
DATABASE_URL=postgresql://lince:troque-esta-senha@localhost:5432/lince?schema=public
REDIS_URL=redis://localhost:6379
