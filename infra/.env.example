# Copie para infra/.env e troque a senha. O .env real nunca entra no git.
#
#   cp infra/.env.example infra/.env

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=lince
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=lince
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379

# --- Câmeras RTSP sintéticas (docker-compose.rtsp.yml) -----------------------
# Só usado em desenvolvimento; não existe na loja.
RTSP_PORT=8554

# --- MinIO (papel do Cloudflare R2 em desenvolvimento) ----------------------
# Senha com no mínimo 8 caracteres: o MinIO recusa subir com menos, e o erro sai
# só no log do container.
MINIO_ROOT_USER=lince
MINIO_ROOT_PASSWORD=troque-esta-senha
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Buckets criados pelo serviço `minio-buckets` no `pnpm infra:up`. O de teste é
# separado porque a suíte da API apaga o que cria — mesma disciplina do schema
# `lince_test` do Postgres.
S3_BUCKET=lince-clipes
TEST_S3_BUCKET=lince-clipes-teste

# --- URLs consumidas pela API (Prisma, BullMQ) ------------------------------
# Mantenha usuário/senha/porta em sincronia com as variáveis acima.
DATABASE_URL=postgresql://lince:troque-esta-senha@localhost:5432/lince?schema=public
REDIS_URL=redis://localhost:6379
