# Copie para infra/.env e troque a senha. O .env real nunca entra no git.
#
#   cp infra/.env.example infra/.env

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=lince
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=lince
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379

# --- Câmeras RTSP sintéticas (docker-compose.rtsp.yml) -----------------------
# Só usado em desenvolvimento; não existe na loja.
RTSP_PORT=8554

# --- S3 local: RustFS (papel do Cloudflare R2 em desenvolvimento) -----------
# Usuário e senha viram a chave de acesso e o segredo do S3 local; a API e o agente
# assinam com eles (S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY em apps/api/.env).
S3_ROOT_USER=lince
S3_ROOT_PASSWORD=troque-esta-senha
S3_PORT=9000
S3_CONSOLE_PORT=9001

# Buckets criados pelo serviço `s3-buckets` no `pnpm infra:up`. O de teste é
# separado porque a suíte da API apaga o que cria — mesma disciplina do schema
# `lince_test` do Postgres.
S3_BUCKET=lince-clipes
TEST_S3_BUCKET=lince-clipes-teste

# --- URLs consumidas pela API (Prisma, BullMQ) ------------------------------
# Mantenha usuário/senha/porta em sincronia com as variáveis acima.
DATABASE_URL=postgresql://lince:troque-esta-senha@localhost:5432/lince?schema=public
REDIS_URL=redis://localhost:6379
