// Schema do control plane. Cobre as rotas de agente da §5.2 (config, register,
// heartbeat), o EVENTO com o desfecho do clipe e o lado humano: USUARIO, TRIAGEM e
// AUDITORIA do diagrama ER de docs/arquitetura.md §6. ENVIO_ALERTA, MODELO_VERSAO e
// POLITICA_RETENCAO ainda não existem — não há notificação, download de modelo nem
// job de expurgo.
//
// Zonas e regras são JSONB por câmera, não tabelas ZONA/REGRA_CONFIG normalizadas:
// decisão explícita desta fatia, porque não há dashboard ainda para justificar editar
// zona por zona num formulário. Normalizar fica para quando essa necessidade existir.
//
// config_version/ETag do documento NÃO são coluna nenhuma aqui: são hash do conteúdo,
// calculados sob demanda em src/config/. Uma coluna exigiria lembrar de bumpá-la em
// todo caminho de escrita futuro — e hoje não existe nenhum. Ver src/config/etag.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id       String   @id
  nome     String
  criadoEm DateTime @default(now()) @map("criado_em")

  lojas    Loja[]
  usuarios Usuario[]

  @@map("tenant")
}

model Loja {
  id       String @id
  tenantId String @map("tenant_id")
  nome     String

  // Blocos de nível-loja do documento config.v1.json (§5.2). JSONB porque o schema
  // de verdade é o JSON Schema em packages/shared/schemas/config.v1.json, validado
  // em app (src/config/schema-validator.ts) — não há necessidade de espelhar cada
  // campo em coluna própria do Postgres.
  detection Json?
  tracking  Json?

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  cameras         Camera[]
  agentes         Agente[]
  tokensBootstrap TokenBootstrap[]
  eventos         Evento[]
  usuarios        UsuarioLoja[]

  @@index([tenantId])
  @@map("loja")
}

model Camera {
  id       String  @id @default(uuid())
  cameraId String  @map("camera_id")
  lojaId   String  @map("loja_id")
  url      String
  detect   Boolean @default(true)

  // Blocos por câmera do documento (§5.2): decode, supervision, clip, rules.
  decode      Json?
  supervision Json?
  clip        Json?
  rules       Json?

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  loja Loja @relation(fields: [lojaId], references: [id])

  // camera_id é único dentro da loja (config.v1.json exige isso; ver comentário na
  // descrição de "cameras" do schema — repetir camera_id manda clipe pro buffer errado).
  @@unique([lojaId, cameraId])
  @@index([lojaId])
  @@map("camera")
}

model Agente {
  id          String    @id @default(uuid())
  lojaId      String    @map("loja_id")
  // SHA-256 hex do token, nunca o token em claro — vale igualmente para a credencial
  // emitida pelo POST /v1/agents/register (§5.1, src/routes/agents/register.ts) e para
  // o token de atalho que o scripts/seed.ts semeia em desenvolvimento.
  tokenHash   String    @unique @map("token_hash")
  // Prefixo em claro só para log/debug sem reconstituir o segredo.
  tokenPrefix String    @map("token_prefix")
  ativo       Boolean   @default(true)
  criadoEm    DateTime  @default(now()) @map("criado_em")
  ultimoUsoEm DateTime? @map("ultimo_uso_em")

  // Último heartbeat (§5.3), não série histórica: HEARTBEAT no §6 é telemetria de
  // retenção própria e curta, e não há hoje dashboard nem job de expurgo para
  // justificar uma tabela insert-only crescendo a cada ~30s por agente sem limite --
  // mesma decisão já tomada para zona/regra em Camera (JSONB até existir consumidor).
  // heartbeatEm sozinho (sem parsear o JSON) é o que sustenta o alerta de agente
  // offline do R-6.
  heartbeatEm DateTime? @map("heartbeat_em")
  heartbeat   Json?

  loja    Loja     @relation(fields: [lojaId], references: [id])
  eventos Evento[]

  @@index([lojaId])
  @@map("agente")
}

// Token de bootstrap (§5.1): de uso único, gerado ao cadastrar a loja (hoje, nesta
// fatia, via scripts/seed.ts -- ainda não há POST /v1/lojas nem dashboard), trocado
// por uma credencial de Agente em POST /v1/agents/register.
//
// usadoEm nullable é o próprio estado de "uso único": null é ainda válido, preenchido
// é já trocado -- e a troca condicional (UPDATE ... WHERE usado_em IS NULL) é o que
// impede duas chamadas concorrentes de register com o mesmo token de criarem dois
// Agente (ver src/routes/agents/register.ts).
model TokenBootstrap {
  id          String    @id @default(uuid())
  lojaId      String    @map("loja_id")
  // SHA-256 hex, mesma disciplina do Agente.tokenHash: nunca o token em claro no banco.
  tokenHash   String    @unique @map("token_hash")
  tokenPrefix String    @map("token_prefix")
  expiraEm    DateTime  @map("expira_em")
  usadoEm     DateTime? @map("usado_em")
  criadoEm    DateTime  @default(now()) @map("criado_em")

  loja Loja @relation(fields: [lojaId], references: [id])

  @@index([lojaId])
  @@map("token_bootstrap")
}

// Origem do gatilho (event.v1.json). `manual` é gatilho humano -- teste de câmera na
// instalação. Existe como enum e não como boolean porque a nuvem PRECISA separar os
// dois para não contaminar a métrica de falso positivo por câmera (NFR-2, R-1): um
// instalador testando 40 vezes numa tarde afundaria a estatística da loja.
enum EventoOrigem {
  rule
  manual

  @@map("evento_origem")
}

// Estado do clipe **no armazenamento**, que não é o `clip.status` do contrato.
//
// Os dois são fáceis de confundir e significam coisas diferentes: o `clip.status` do
// POST é o desfecho do **corte** na borda (o §3.5 conseguiu produzir o arquivo?), e o
// do PATCH é o desfecho do **upload** (os bytes chegaram ao R2?). Um clipe cortado com
// sucesso ainda vira `clip_failed` se as tentativas se esgotarem ou o teto de disco o
// despejar antes de subir (outbox/event.py, build_clip_patch).
//
// `pendente` é o estado que o contrato não tem nome para: a nuvem conhece o evento,
// emitiu a URL, e os bytes ainda não chegaram. Sem ele, a triagem não conseguiria
// distinguir "o vídeo está subindo" de "não vai haver vídeo" -- e a segunda é a que
// libera o triador a decidir sem esperar.
enum ClipeEstado {
  pendente
  disponivel
  indisponivel

  @@map("clipe_estado")
}

// EVENTO do §6: o alerta que a borda decidiu emitir. Nunca carrega vídeo -- o clipe
// vai direto da loja para o R2 por URL pré-assinada (§4.4) e o que fica aqui é a
// chave do objeto.
model Evento {
  // O event_id do payload É a identidade da linha, não uma coluna a mais ao lado de um
  // id gerado aqui. A idempotência do §5.4 vira chave primária: duas chegadas do mesmo
  // POST não podem produzir duas linhas, e essa garantia passa a ser do banco em vez
  // de depender de todo caminho de escrita futuro lembrar de um upsert.
  eventId String @id @map("event_id")

  tenantId String @map("tenant_id")
  lojaId   String @map("loja_id")

  // Texto, sem FK para Camera de propósito. Um evento que sobe seis horas depois,
  // porque o link caiu, pode chegar com a câmera já removida da configuração no
  // dashboard. Com FK, o INSERT falharia, a API responderia erro e o agente mandaria o
  // evento para a fila morta (outbox/policy.py) -- um alerta real perdido por causa de
  // uma edição de cadastro feita no meio do caminho. A referência é fraca porque o
  // evento é o registro histórico e o cadastro é mutável.
  cameraId String @map("camera_id")

  // Quem mandou. Nulo se aquela credencial já não existe: a rotação da §5.1 cria um
  // Agente novo, e um evento de dezembro não pode desaparecer porque a loja trocou de
  // credencial em janeiro.
  agenteId String? @map("agente_id")

  // ocorridoEm é o gatilho; reportadoEm é o relógio de parede da borda ao enfileirar;
  // recebidoEm é o relógio da nuvem. Os três existem separados porque a diferença
  // entre eles é justamente o que denuncia link caído (recebido - reportado) e deriva
  // de relógio do box (reportado - ocorrido).
  ocorridoEm  DateTime @map("ocorrido_em")
  reportadoEm DateTime @map("reportado_em")
  recebidoEm  DateTime @default(now()) @map("recebido_em")

  source EventoOrigem

  // Regra que disparou, achatada em duas colunas em vez de JSONB: é por
  // (regra, versão) que se lê taxa de falso positivo, e uma métrica que se vai
  // agrupar não pode morar dentro de um JSON. Nulas quando source = manual.
  regraId     String? @map("regra_id")
  regraVersao Int?    @map("regra_versao")

  // Blocos do documento guardados como vieram (mesma decisão do JSONB por câmera).
  // `clip` aqui é o bloco do POST -- o desfecho do CORTE, com pré/pós-roll medidos e
  // fragmentos. O desfecho do upload não mora nele; mora em clipeEstado abaixo.
  versions Json
  clip     Json

  clipeEstado      ClipeEstado @default(pendente) @map("clipe_estado")
  clipeObjectKey   String?     @map("clipe_object_key")
  // Motivo de o vídeo não existir, vindo do PATCH clip_failed. É o que o triador lê
  // para saber que não adianta esperar -- "clipe despejado pelo teto de disco" e
  // "câmera reconectou no meio do corte" pedem ações diferentes do técnico.
  clipeErro        String?     @map("clipe_erro")
  clipeResolvidoEm DateTime?   @map("clipe_resolvido_em")

  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  loja     Loja      @relation(fields: [lojaId], references: [id])
  agente   Agente?   @relation(fields: [agenteId], references: [id], onDelete: SetNull)
  triagens Triagem[]

  // Todo índice começa por tenant_id: é assim que a query da fila de triagem fica
  // fisicamente incapaz de varrer evento de outro tenant (NFR-6).
  @@index([tenantId, ocorridoEm])
  @@index([tenantId, lojaId, cameraId, ocorridoEm])
  // A fila de clipes pendentes: o que a nuvem varre para saber que upload nunca veio.
  @@index([tenantId, clipeEstado])
  @@map("evento")
}

// Papel do usuário **na loja**, como o §6 define (USUARIO_LOJA). Não é papel de
// tenant: uma rede com dez lojas tem gerente que só enxerga a dele, e um papel global
// obrigaria a escolher entre "vê tudo" e "não vê nada".
//
// `admin` é o papel que administra gente -- e administra gente **daquela loja**. Quem
// cria ou edita usuário precisa ser admin de todas as lojas envolvidas no vínculo
// (routes/usuarios/*), o que mantém a autorização inteira dentro do mesmo conceito em
// vez de inventar um segundo eixo de permissão por cima.
enum PapelUsuario {
  admin
  gerente
  operador

  @@map("papel_usuario")
}

// Os três desfechos do §4.5, com os mesmos literais do texto da arquitetura. Três, e
// não dois, porque `inconclusivo` é o que impede o triador de chutar: sem ele, um
// clipe em que não dá para ver nada vira "falso positivo" e envenena exatamente a
// métrica que o R-1 existe para medir.
enum DecisaoTriagem {
  confirmado
  falso_positivo
  inconclusivo

  @@map("decisao_triagem")
}

// Ação registrada na trilha de auditoria. Enum de um valor só hoje, e enum mesmo
// assim: a alternativa (texto livre) faz a primeira consulta de auditoria descobrir
// que existem três grafias da mesma ação escritas em meses diferentes.
enum AuditoriaAcao {
  clipe_url_emitida

  @@map("auditoria_acao")
}

// USUARIO do §6: gente, não box. Fica separado de Agente de propósito -- são duas
// credenciais com poderes disjuntos, e juntá-las numa tabela só ("principal") faria
// um token de loja comprometido (que vive num box no estoque de um mercado) partilhar
// caminho de código com quem pode ler clipe e triar evento.
model Usuario {
  id String @id @default(uuid())

  tenantId String @map("tenant_id")

  // Único no sistema inteiro, não por tenant. O login recebe e-mail e senha e mais
  // nada: o gerente está em pé no corredor, e um seletor de tenant na tela de login é
  // um campo que ele não sabe preencher. Unicidade por tenant exigiria esse campo,
  // porque o mesmo e-mail em dois tenants tornaria a credencial ambígua.
  email String @unique

  nome String

  // scrypt com sal por usuário (auth/senha.ts), nunca o SHA-256 usado nos tokens de
  // agente: token é 256 bits aleatórios, senha é escolhida por gente e cabe em
  // dicionário. Hash rápido sobre senha humana é vazamento de banco virando lista de
  // senhas em claro na mesma tarde.
  senhaHash String @map("senha_hash")

  ativo Boolean @default(true)

  // Revogação de todos os JWTs já emitidos para este usuário, sem tabela de sessão: o
  // token carrega a versão que existia quando foi assinado, e a autenticação recusa
  // quem trouxer versão diferente (auth/usuario-token.ts). É o que faz "trocar a
  // senha" e "demiti o funcionário hoje" valerem agora, e não quando o token vencer.
  tokenVersao Int @default(0) @map("token_versao")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  lojas    UsuarioLoja[]
  triagens Triagem[]

  @@index([tenantId])
  @@map("usuario")
}

// USUARIO_LOJA do §6. Tabela de ligação com papel, e não uma coluna `lojaId` em
// Usuario: um gerente de duas lojas é o caso normal numa rede pequena, e o dono
// costuma ser admin de todas.
model UsuarioLoja {
  usuarioId String       @map("usuario_id")
  lojaId    String       @map("loja_id")
  papel     PapelUsuario
  criadoEm  DateTime     @default(now()) @map("criado_em")

  // Cascade só aqui: o vínculo não é histórico, é cadastro. Apagar o vínculo não
  // apaga triagem nenhuma -- a decisão já tomada continua de pé com o autor dela.
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  loja    Loja    @relation(fields: [lojaId], references: [id])

  @@id([usuarioId, lojaId])
  @@index([lojaId])
  @@map("usuario_loja")
}

// TRIAGEM do §6: a decisão humana que o §1 exige antes de qualquer consequência.
//
// **Append-only.** Mudar de ideia grava uma linha nova; a decisão vigente é a última.
// Não é zelo de auditoria: é o dedo errado no corredor. O gerente tria em dois toques
// com o celular numa mão (NFR-9), e uma decisão imutável transformaria um toque errado
// em falso positivo permanente na estatística da câmera -- justamente o número que o
// R-1 manda vigiar. Guardar o histórico deixa a correção acontecer sem apagar que
// houve correção.
model Triagem {
  id String @id @default(uuid())

  // O que define "a última". Não dá para ser criadoEm sozinho: duas decisões no mesmo
  // milissegundo empatariam, e "vigente" viraria cara ou coroa. A sequência não empata
  // nunca. (Ela também não é ordem de commit -- para duas decisões de gente, com
  // segundos entre elas, isso não muda nada.)
  seq Int @unique @default(autoincrement())

  eventId  String @map("event_id")
  tenantId String @map("tenant_id")

  // Com FK, e sem onDelete: apagar um usuário que já triou passa a ser recusado pelo
  // banco. É o comportamento certo -- quem saiu da empresa é desativado (ativo=false),
  // não removido, senão a trilha perde o autor de decisões que continuam valendo.
  usuarioId String @map("usuario_id")

  decisao DecisaoTriagem

  // O que o triador viu e a caixa de seleção não cobre ("cliente devolveu na gôndola
  // da frente"). É daqui que sai o caso difícil para o dataset (§4.5).
  observacao String?

  criadoEm DateTime @default(now()) @map("criado_em")

  evento  Evento  @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  // A consulta quente da fila: "qual a decisão vigente deste evento" é ORDER BY seq
  // DESC LIMIT 1 dentro do event_id.
  @@index([eventId, seq])
  @@index([tenantId, criadoEm])
  @@map("triagem")
}

// AUDITORIA do §6, append-only: quem, qual evento, quando e de onde (NFR-7, R-8).
//
// Gravada na **emissão** da URL assinada, não no download: é o único instante em que a
// nuvem sabe quem pediu. O GET que busca os bytes vai direto ao R2 com a assinatura na
// query e não passa pela API -- é o preço de o vídeo nunca atravessar o control plane
// (§4.4), e a linha aqui é o que resta para responder "quem teve acesso a este clipe".
model Auditoria {
  id String @id @default(uuid())

  tenantId String        @map("tenant_id")
  acao     AuditoriaAcao

  // Texto e cópia do e-mail, sem FK -- mesma decisão de Evento.cameraId, por um motivo
  // mais forte: uma trilha que perde o autor quando o cadastro muda não é trilha. Com
  // FK e SetNull, apagar o usuário apagaria justamente o "quem" das linhas dele.
  usuarioId    String @map("usuario_id")
  usuarioEmail String @map("usuario_email")

  eventId   String? @map("event_id")
  objectKey String? @map("object_key")

  // "De onde". Melhor esforço: atrás de proxy é o que o X-Forwarded-For disser, e por
  // isso serve para investigar, nunca para autorizar.
  ip        String?
  userAgent String? @map("user_agent")

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([tenantId, criadoEm])
  @@index([eventId])
  @@map("auditoria")
}
