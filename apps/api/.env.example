# Copie para .env. As duas primeiras já vêm formatadas em infra/.env.example —
# esta API lê a mesma variável, não uma cópia divergente.
DATABASE_URL=postgresql://lince:troque-esta-senha@localhost:5432/lince?schema=public

# Schema separado no MESMO Postgres de infra/docker-compose.yml — não é infra nova.
# Isolado do schema "public" para que rodar a suíte de teste (TRUNCATE entre testes)
# nunca apague dados que o dev estava usando para testar o agente na mão.
TEST_DATABASE_URL=postgresql://lince:troque-esta-senha@localhost:5432/lince?schema=lince_test

PORT=3000

# --- Armazenamento de clipes (§4.4) -----------------------------------------
# Em desenvolvimento é o MinIO de infra/docker-compose.yml; em produção é o
# Cloudflare R2. Só o endpoint e as credenciais mudam — a API assina igual nos
# dois, path-style, porque R2 e MinIO aceitam ambos.
#
# No R2: S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com e S3_REGION=auto
# (o R2 ignora a região, mas ela entra no escopo da assinatura e não pode faltar).
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=lince
S3_SECRET_ACCESS_KEY=troque-esta-senha
S3_BUCKET=lince-clipes

# Bucket separado para a suíte, que apaga o que cria — mesmo motivo do schema
# lince_test acima. Os dois são criados pelo `pnpm infra:up`.
TEST_S3_BUCKET=lince-clipes-teste

# Validade da URL pré-assinada de upload do clipe. Curta de propósito (NFR-7): o
# agente já sabe renovar uma URL vencida repetindo o POST, que é idempotente
# (§5.4), então esticar isto só aumentaria a janela de uma URL vazada.
CLIP_UPLOAD_EXPIRES_S=900
